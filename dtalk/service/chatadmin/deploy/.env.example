# chatadmin 独立部署环境变量
# 复制后修改: cp .env.example .env
# .env 含口令，不要提交。

# 运行环境：production 或 debug
DTALKENV=production

# 放到本目录的 Linux 二进制文件名
BINARY_NAME=chatadmin

# 宿主机映射端口。容器内固定 18020
HTTP_HOST_PORT=18020

# 已有 MySQL。本 compose 不启动数据库。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PWD=your_password_here
MYSQL_DB=dtalk

# 记录库。与主库相同则可照抄上面的主机和口令。
MYSQL_RECORD_HOST=mysql
MYSQL_RECORD_PORT=3306
MYSQL_RECORD_USER=root
MYSQL_RECORD_PWD=your_password_here
MYSQL_RECORD_DB=dtalk_record

# 已有 Redis。没设密码时留空。
REDIS_ADDR=redis:6379
REDIS_AUTH=

# 登录令牌。上线前换成足够长的随机串。
JWT_SECRET=please-change-me-to-a-strong-random-secret
JWT_TTL_SECONDS=7200

# 浏览器打开运营台时地址栏里的「协议+主机+端口」，不要带路径。
# 页面由本服务的 /console/ 提供时，填对外访问地址即可。
CORS_ORIGIN=http://127.0.0.1:18020
