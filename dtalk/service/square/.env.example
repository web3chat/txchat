# 复制为 .env 后按需修改。
# make compose-up 会读取本文件（密码、JWT、超管、MOCK 等）；容器内数据库仍固定为 postgres:5432。
# 不设 SQUARE_PG_HOST 时，本机 go run 会按下面账号自动创建 Docker PostgreSQL。

SQUARE_ENV=local
SQUARE_ALLOW_MOCK=true
SQUARE_HTTP_ADDR=:18100

# 留空 = 本机 go run 自动建库容器（127.0.0.1:15432）。make compose-up 不把数据库映射到主机。
# 已有外部库则填写，例如 127.0.0.1
# SQUARE_PG_HOST=
SQUARE_PG_PORT=15432
SQUARE_PG_USER=square
SQUARE_PG_PASSWORD=square
SQUARE_PG_DB=square
SQUARE_PG_SSLMODE=disable

SQUARE_JWT_SECRET=dev-square-jwt-secret-change-me-32b
SQUARE_BOOTSTRAP_ADMIN_USER=admin
SQUARE_BOOTSTRAP_ADMIN_PASSWORD=change-me-please-12
# 忘记根管理员密码时改为 true，把上一行写成新密码，重启一次。登录成功后改回 false，否则每次启动都会把密码覆盖回环境变量。
# SQUARE_ADMIN_PASSWORD_RESET=false
# 库里没有同名账号时才会创建，已存在的不改密码。格式：用户名:密码:角色，多条用逗号分隔。角色 super 或 reviewer。密码至少 12 位，不要含逗号、冒号或 $。
SQUARE_BOOTSTRAP_ADMINS=developer:change-me-please-12:super,operator:change-me-please-12:reviewer

# 文字和带图都用 DEEPSEEK_MODEL / DEEPSEEK_VISION_MODEL，默认都是 deepseek-flash。deepseek-chat 已下线。
# DEEPSEEK_API_KEY=
# DEEPSEEK_VISION_MODEL=deepseek-flash

# 谈信 IM nginx 上的 OSS，与 ChatPro 相同：POST ${SQUARE_OSS_URL}/oss/upload
SQUARE_OSS_URL=http://localhost:8888
SQUARE_OSS_APP_ID=dtalk
# 广场服务签 OSS 的固定 secp256k1 私钥（64 位 hex）。写在 .env / .env.prod，不要提交真实值
SQUARE_OSS_PRIVKEY=

# 广场帖/公众号文章过期软删：0 关闭，30–62 天。OSS 删图默认关，等 dtalk 有 /oss/delete 再开。
SQUARE_POST_TTL_DAYS=45
SQUARE_RETENTION_INTERVAL=1h
SQUARE_OSS_DELETE=false
SQUARE_HOT_WINDOW_DAYS=7
