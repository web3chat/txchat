# chatclean Docker 部署环境变量
# 复制本文件为 .env 后按需修改: cp .env.example .env

# 运行环境
DTALKENV=production
LOG_LEVEL=info

# 二进制文件名（make build 产出的文件名，如 chatclean_v0.1.0）
BINARY_NAME=chatclean

# gRPC 宿主机端口映射
GRPC_HOST_PORT=30010

# etcd 注册中心（容器内地址或外部地址）
REGADDRS=127.0.0.1:2379

# 注册到 etcd 的地址（留空则自动探测容器 IP；填宿主机 IP:端口 可让其它网络的容器也能访问）
REGISTER_ADDR=

# MySQL 配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PWD=your_password_here
MYSQL_DB=dtalk
MYSQL_RECORD_DB=dtalk_record

# 定时清理调度器
SCHEDULER_INTERVAL=1h
SCHEDULER_BATCH_SIZE=500

# 与 store 使用同一台 Redis。没设密码时留空。
REDIS_ADDR=txchat-redis:6379
REDIS_AUTH=

# 与本集群 OSS 使用同一套 MinIO。不要把真实密钥提交到仓库。
MINIO_ENDPOINT=txchat-minio:9000
MINIO_BUCKET=dtalk-minio-bucket
MINIO_ACCESS_KEY=your_minio_user
MINIO_SECRET_KEY=your_minio_password_here
