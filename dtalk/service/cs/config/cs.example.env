# 示例：复制到 CS 进程工作目录下的 .env，或通过启动参数指定：
#   ./cs -conf cs.toml -dotenv /path/to/.env
#
# 说明：
# - 以下变量若已存在于操作系统环境中，不会被 .env 覆盖（与常见 dotenv 行为一致）。
# - ApplyOfflineAIEnvOverrides 在读取 cs.toml、合并 .env 之后执行：环境变量可覆盖 toml 里的同语义字段。
# - 路径类变量指向的文件在 ExpandOfflineAITerminologyFiles 中读取，会覆盖对应的内联话术字段。

# CS_OFFLINE_AI_DEEPSEEK_API_KEY=
# CS_OFFLINE_AI_COMET_URL=

# CS_OFFLINE_AI_BASE_SYSTEM_PROMPT_FILE=./config/terms/system_prompt.txt
# CS_OFFLINE_AI_PLAYBOOK_FILE=./config/terms/playbook.txt
# CS_OFFLINE_AI_INTRO_FILE=./config/terms/intro.md
# CS_OFFLINE_AI_HANDOFF_FILE=./config/terms/handoff.txt

# 也可直接内联（适合较短片段；长文本建议用 *_FILE）：
# CS_OFFLINE_AI_PLAYBOOK=
# CS_OFFLINE_AI_INTRO_MARKDOWN=
# CS_OFFLINE_AI_HANDOFF_CLOSING=
# CS_OFFLINE_AI_BASE_SYSTEM_PROMPT=
